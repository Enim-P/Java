<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.bing.mapper.SubjectMapper">
    <!--分页加条件查询课程信息-->
    <select id="findByCondition" resultType="com.bing.pojo.Subject">
        select * from subject
        <where>
            <if test="gradeId!=null and gradeId!=0">
                and gradeId=#{gradeId}
            </if>
            <if test="subjectName!=null">
                and subjectName like concat('%',#{subjectName},'%')
            </if>
        </where>
        limit #{skipSize},#{pageSize}
    </select>
    <!--根据条件查询课程数量-->
    <select id="findByConditionSize" resultType="java.lang.Long">
        select count(*) from subject
        <where>
            <if test="gradeId!=null and gradeId!=0">
                and gradeId=#{gradeId}
            </if>
            <if test="subjectName!=null">
                and subjectName like concat('%',#{subjectName},'%')
            </if>
        </where>
    </select>
    <!--根据条件查询课程-->
    <select id="findByCondition2" resultType="com.bing.pojo.Subject">
        select * from subject
        <where>
            <if test="gradeId!=null and gradeId!=0">
                and gradeId=#{gradeId}
            </if>
            <if test="subjectName!=null">
                and subjectName like concat('%',#{subjectName},'%')
            </if>
        </where>
    </select>
</mapper>